                                      "type": "number"
                                    },
                                    "CurveParameters": {
                                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CurveParameters",
                                      "type": "object",
                                      "required": [
                                        "ExtractionMode",
                                        "EdgeThreshold",
                                        "EdgeFilterSize",
                                        "MinLength",
                                        "RowSearchStepSize",
                                        "ColSearchStepSize",
                                        "MaxEndpointGap",
                                        "Closed",
                                        "Subpixel"
                                      ],
                                      "properties": {
                                        "ExtractionMode": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CurveParameters/properties/ExtractionMode",
                                          "type": "number"
                                        },
                                        "EdgeThreshold": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CurveParameters/properties/EdgeThreshold",
                                          "type": "number"
                                        },
