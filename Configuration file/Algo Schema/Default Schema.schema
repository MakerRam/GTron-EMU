{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/root.json",
  "type": "object",
  "required": [
    "SpecificationVersion",
    "CompatibleSoftwareVersions",
    "AlgoParameters"
  ],
  "properties": {
    "SpecificationVersion": {
      "$id": "#/properties/SpecificationVersion",
      "type": "string",
      "pattern": "^(.*)$"
    },
    "CompatibleSoftwareVersions": {
      "$id": "#/properties/CompatibleSoftwareVersions",
      "type": "array",
      "items": {
        "$id": "#/properties/CompatibleSoftwareVersions/items",
        "type": "string",
        "pattern": "^(.*)$"
      }
    },
    "AlgoParameters": {
      "$id": "#/properties/AlgoParameters",
      "type": "object",
      "required": [
        "PartsList",
        "AlgoDefaultParameters"
      ],
      "properties": {
        "PartsList": {
          "$id": "#/properties/AlgoParameters/properties/PartsList",
          "type": "array",
          "items": {
            "$id": "#/properties/AlgoParameters/properties/PartsList/items",
            "type": "object",
            "required": [
              "Name",
              "ImageStreams",
              "Measurements"
            ],
            "properties": {
              "Name": {
                "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/Name",
                "type": "string",
                "pattern": "^(.*)$"
              },
              "ImageStreams": {
                "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams",
                "type": "array",
                "items": {
                  "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items",
                  "type": "object",
                  "required": [
                    "ThreadName",
                    "RackEnable",
                    "ThreadId",
                    "RackId",
                    "DifferenceParameter",
                    "SplitCameraIDs",
                    "ImagingViews"
                  ],
                  "properties": {
                    "ThreadName": {
                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ThreadName",
                      "type": "string",
                      "pattern": "^(.*)$"
                    },
                    "RackEnable": {
                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/RackEnable",
                      "type": "boolean"
                    },
                    "ThreadId": {
                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ThreadId",
                      "type": "number"
                    },
                    "RackId": {
                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/RackId",
                      "type": "number"
                    },
                    "DifferenceParameter": {
                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/DifferenceParameter",
                      "type": "number"
                    },
                    "SplitCameraIDs": {
                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/SplitCameraIDs",
                      "type": "array",
                      "items": {
                        "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/SplitCameraIDs/items",
                        "type": "number"
                      }
                    },
                    "ImagingViews": {
                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews",
                      "type": "array",
                      "items": {
                        "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items",
                        "type": "object",
                        "required": [
                          "ViewName",
                          "ViewEnable",
                          "ImageID",
                          "CameraID",
                          "CalibrationFilePath",
                          "CalibImageFormat",
                          "ReferenceCoordSystem",
                          "CameraAngle"
                        ],
                        "properties": {
                          "ViewName": {
                            "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ViewName",
                            "type": "string",
                            "pattern": "^(.*)$"
                          },
                          "ViewEnable": {
                            "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ViewEnable",
                            "type": "boolean"
                          },
                          "ImageID": {
                            "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ImageID",
                            "type": "number"
                          },
                          "CameraID": {
                            "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/CameraID",
                            "type": "number"
                          },
                          "CalibrationFilePath": {
                            "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/CalibrationFilePath",
                            "type": "string",
                            "pattern": "^(.*)$"
                          },
                          "CalibImageFormat": {
                            "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/CalibImageFormat",
                            "type": "string",
                            "pattern": "^(.*)$"
                          },
                          "ReferenceCoordSystem": {
                            "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem",
                            "type": "object",
                            "required": [
                              "Method",
                              "ROI",
                              "Name",
                              "OverlayOptions"
                            ],
                            "properties": {
                              "Method": {
                                "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/Method",
                                "type": "object",
                                "required": [
                                  "Algo",
                                  "BaseReference"
                                ],
                                "properties": {
                                  "Algo": {
                                    "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/Method/properties/Algo",
                                    "type": "string",
                                    "pattern": "^(.*)$"
                                  },
                                  "BaseReference": {
                                    "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/Method/properties/BaseReference",
                                    "type": "object",
                                    "required": [
                                      "OriginX",
                                      "OriginY",
                                      "Angle",
                                      "AxisReference"
                                    ],
                                    "properties": {
                                      "OriginX": {
                                        "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/Method/properties/BaseReference/properties/OriginX",
                                        "type": "number"
                                      },
                                      "OriginY": {
                                        "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/Method/properties/BaseReference/properties/OriginY",
                                        "type": "number"
                                      },
                                      "Angle": {
                                        "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/Method/properties/BaseReference/properties/Angle",
                                        "type": "number"
                                      },
                                      "AxisReference": {
                                        "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/Method/properties/BaseReference/properties/AxisReference",
                                        "type": "number"
                                      }
                                    }
                                  }
                                }
                              },
                              "ROI": {
                                "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI",
                                "type": "array",
                                "items": {
                                  "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items",
                                  "type": "object",
                                  "required": [
                                    "ROI",
                                    "EdgeOptions",
                                    "LineOptions",
                                    "Process",
                                    "StepSize",
                                    "SearchDirection",
                                    "CircleEdgeOptions",
                                    "CircleFitOptions",
                                    "CircleSearchDirection",
                                    "CurveParameters",
                                    "MinimumMatchScore",
                                    "CircleDescriptor",
                                    "EllipseDescriptor",
                                    "ParallelLines"
                                  ],
                                  "properties": {
                                    "ROI": {
                                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/ROI",
                                      "type": "object",
                                      "required": [
                                        "Left",
                                        "Top",
                                        "Right",
                                        "Bottom",
                                        "Rotation"
                                      ],
                                      "properties": {
                                        "Left": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/ROI/properties/Left",
                                          "type": "number"
                                        },
                                        "Top": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/ROI/properties/Top",
                                          "type": "number"
                                        },
                                        "Right": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/ROI/properties/Right",
                                          "type": "number"
                                        },
                                        "Bottom": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/ROI/properties/Bottom",
                                          "type": "number"
                                        },
                                        "Rotation": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/ROI/properties/Rotation",
                                          "type": "number"
                                        }
                                      }
                                    },
                                    "EdgeOptions": {
                                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/EdgeOptions",
                                      "type": "object",
                                      "required": [
                                        "EdgePolarity",
                                        "KernelSize",
                                        "Width",
                                        "MinimumEdgeStrength",
                                        "InterpolationType",
                                        "DataProcessingMethod"
                                      ],
                                      "properties": {
                                        "EdgePolarity": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/EdgeOptions/properties/EdgePolarity",
                                          "type": "number"
                                        },
                                        "KernelSize": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/EdgeOptions/properties/KernelSize",
                                          "type": "number"
                                        },
                                        "Width": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/EdgeOptions/properties/Width",
                                          "type": "number"
                                        },
                                        "MinimumEdgeStrength": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/EdgeOptions/properties/MinimumEdgeStrength",
                                          "type": "number"
                                        },
                                        "InterpolationType": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/EdgeOptions/properties/InterpolationType",
                                          "type": "number"
                                        },
                                        "DataProcessingMethod": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/EdgeOptions/properties/DataProcessingMethod",
                                          "type": "number"
                                        }
                                      }
                                    },
                                    "LineOptions": {
                                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions",
                                      "type": "object",
                                      "required": [
                                        "NumberofLines",
                                        "Type",
                                        "MinScore",
                                        "MaxScore",
                                        "Orientation",
                                        "AngleRange",
                                        "AngleTolerance",
                                        "StepSize",
                                        "MinSNR",
                                        "MinPoints",
                                        "HoughIterations"
                                      ],
                                      "properties": {
                                        "NumberofLines": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/NumberofLines",
                                          "type": "number"
                                        },
                                        "Type": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/Type",
                                          "type": "number"
                                        },
                                        "MinScore": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/MinScore",
                                          "type": "number"
                                        },
                                        "MaxScore": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/MaxScore",
                                          "type": "number"
                                        },
                                        "Orientation": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/Orientation",
                                          "type": "number"
                                        },
                                        "AngleRange": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/AngleRange",
                                          "type": "number"
                                        },
                                        "AngleTolerance": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/AngleTolerance",
                                          "type": "number"
                                        },
                                        "StepSize": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/StepSize",
                                          "type": "number"
                                        },
                                        "MinSNR": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/MinSNR",
                                          "type": "number"
                                        },
                                        "MinPoints": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/MinPoints",
                                          "type": "number"
                                        },
                                        "HoughIterations": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/LineOptions/properties/HoughIterations",
                                          "type": "number"
                                        }
                                      }
                                    },
                                    "Process": {
                                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/Process",
                                      "type": "number"
                                    },
                                    "StepSize": {
                                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/StepSize",
                                      "type": "number"
                                    },
                                    "SearchDirection": {
                                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/SearchDirection",
                                      "type": "number"
                                    },
                                    "CircleEdgeOptions": {
                                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleEdgeOptions",
                                      "type": "object",
                                      "required": [
                                        "SearchDirection",
                                        "EdgeOptions"
                                      ],
                                      "properties": {
                                        "SearchDirection": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleEdgeOptions/properties/SearchDirection",
                                          "type": "number"
                                        },
                                        "EdgeOptions": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleEdgeOptions/properties/EdgeOptions",
                                          "type": "object",
                                          "required": [
                                            "EdgePolarity",
                                            "KernelSize",
                                            "Width",
                                            "MinimumEdgeStrength",
                                            "InterpolationType",
                                            "DataProcessingMethod"
                                          ],
                                          "properties": {
                                            "EdgePolarity": {
                                              "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleEdgeOptions/properties/EdgeOptions/properties/EdgePolarity",
                                              "type": "number"
                                            },
                                            "KernelSize": {
                                              "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleEdgeOptions/properties/EdgeOptions/properties/KernelSize",
                                              "type": "number"
                                            },
                                            "Width": {
                                              "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleEdgeOptions/properties/EdgeOptions/properties/Width",
                                              "type": "number"
                                            },
                                            "MinimumEdgeStrength": {
                                              "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleEdgeOptions/properties/EdgeOptions/properties/MinimumEdgeStrength",
                                              "type": "number"
                                            },
                                            "InterpolationType": {
                                              "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleEdgeOptions/properties/EdgeOptions/properties/InterpolationType",
                                              "type": "number"
                                            },
                                            "DataProcessingMethod": {
                                              "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleEdgeOptions/properties/EdgeOptions/properties/DataProcessingMethod",
                                              "type": "number"
                                            }
                                          }
                                        }
                                      }
                                    },
                                    "CircleFitOptions": {
                                      "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleFitOptions",
                                      "type": "object",
                                      "required": [
                                        "Process",
                                        "StepSize",
                                        "MAxPixelRadius"
                                      ],
                                      "properties": {
                                        "Process": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleFitOptions/properties/Process",
                                          "type": "number"
                                        },
                                        "StepSize": {
                                          "$id": "#/properties/AlgoParameters/properties/PartsList/items/properties/ImageStreams/items/properties/ImagingViews/items/properties/ReferenceCoordSystem/properties/ROI/items/properties/CircleFitOptions/properties/StepSize",
                                          "type": "number"
                                        },
